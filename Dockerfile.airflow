ARG AIRFLOW_VERSION=3.1.7
FROM apache/airflow:${AIRFLOW_VERSION}-python3.12

ARG AIRFLOW_VERSION

COPY --chown=airflow:root pyproject.toml README.md /opt/metadata-etl/
COPY --chown=airflow:root src /opt/metadata-etl/src

RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" /opt/metadata-etl
